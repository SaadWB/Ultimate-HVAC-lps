{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/thank-you.css",
      "destination": "/thank-you/thank-you.css"
    },
    {
      "source": "/thank-you.js",
      "destination": "/thank-you/thank-you.js"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/ac-installation",
      "permanent": false
    }
  ]
}
